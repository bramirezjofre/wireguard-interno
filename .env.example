# Configuración de wireguard-interno
# Copiar este archivo a `.env` y rellenar con valores reales.
# El `.env` está en `.gitignore` y NO se commitea.

# === Server ===
# IP del server donde corre este compose (visible para los devices)
SERVER_IP=192.168.1.4

# === WireGuard ===
# Puerto UDP donde escucha WireGuard
WG_PORT=51820
# Subred de la VPN (no debe chocar con la LAN ni con la VPN externa en server-19)
WG_NETWORK=10.14.14.0/24
# IP del server dentro de la VPN
WG_SERVER_IP=10.14.14.1

# === Peers ===
# Cantidad de peers a generar al primer arranque
PEER_COUNT=5

# === DNS ===
# IP del Pi-hole que se push a los peers como DNS
PIHOLE_DNS=192.168.1.3

# === Portal de onboarding ===
# Puerto donde Caddy sirve los archivos .conf
ONBOARDING_PORT=8081
