:8080 {
    encode gzip

    # Healthcheck
    handle /health {
        respond "OK" 200
    }

    # Página principal
    handle / {
        root * /srv/onboarding
        rewrite * /index.html
        file_server
    }

    # Descarga de los .conf (uno por peer)
    # Manejamos cada peer explícitamente
    handle /peers/peer1.conf {
        root * /peers
        rewrite * /peer1.conf
        header Content-Type text/plain
        header Content-Disposition "attachment; filename=peer1.conf"
        file_server
    }
    handle /peers/peer2.conf {
        root * /peers
        rewrite * /peer2.conf
        header Content-Type text/plain
        header Content-Disposition "attachment; filename=peer2.conf"
        file_server
    }
    handle /peers/peer3.conf {
        root * /peers
        rewrite * /peer3.conf
        header Content-Type text/plain
        header Content-Disposition "attachment; filename=peer3.conf"
        file_server
    }
    handle /peers/peer4.conf {
        root * /peers
        rewrite * /peer4.conf
        header Content-Type text/plain
        header Content-Disposition "attachment; filename=peer4.conf"
        file_server
    }
    handle /peers/peer5.conf {
        root * /peers
        rewrite * /peer5.conf
        header Content-Type text/plain
        header Content-Disposition "attachment; filename=peer5.conf"
        file_server
    }

    # Fallback estático
    handle /* {
        root * /srv/onboarding
        file_server
    }

    log {
        level INFO
    }
}
